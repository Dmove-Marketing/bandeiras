---
// Gerada por tools/build-page.mjs a partir do HTML do Claude Design e depois editada à mão (Hero, Conceito, Espaços, Experiências, Gastronomia e Galeria).
// Não rode o build-page.mjs de novo sem antes comparar: ele sobrescreve estes ajustes.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/form/LeadForm.astro';
import Rodape from '../components/Rodape.astro';
import { tipoEventoOptionsCorporativo } from '../scripts/form-presets';
import '../styles/bandeiras-base.css';
import '../styles/eventos-corporativos.css';
import '../styles/form.css';
---

<Base
  title="Eventos corporativos em Votorantim | Bandeiras Empresarial"
  description="Um ecossistema que conecta empresas, pessoas e experiências. Auditório, salas de treinamento, Espaço Motor, Espaço Arena e Pista de Drift em 100 mil m² em Votorantim, região de Sorocaba. Solicite orçamento."
  ogImage="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-hero-fachada.webp"
  canonical="https://eventos.bandeirasempresarial.com.br/eventos-corporativos/"
  whatsAppShowEmpresaField={true}
  whatsAppTipoOptions={tipoEventoOptionsCorporativo}
>
<Fragment slot="head">
  <link rel="preload" href="/fonts/Nexa-Heavy.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500&family=Roboto:wght@400;500;700&display=swap" />
  <script is:inline>
    /* "js": recursos que dependem de script. "js-anim": animações de entrada, só sem pedido de movimento reduzido. */
    document.documentElement.classList.add('js');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-anim');
  </script>
</Fragment>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>


<main id="conteudo">

<!-- ===================== HERO ===================== -->
<section class="hero" id="topo">
  <div class="hero__topo">
    <div class="wrap"><a class="hero__logo" href="#topo"><img width="720" height="107" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-logo-bandeiras-branco.webp" alt="Bandeiras Empresarial"></a></div>
  </div>
  <div class="hero__midia">
    <img width="1920" height="1080" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-hero-fachada.webp" alt="Fachada do Bandeiras Empresarial ao entardecer, na Av. Ireno da Silva Venâncio, 199, em Votorantim" fetchpriority="high" decoding="async">
  </div>
  <div class="wrap hero__conteudo">
    <p class="eyebrow eyebrow--claro" data-hero>Eventos Corporativos • Votorantim</p>
    <h1 class="hero__titulo">
      <span class="linha"><span data-hero-linha>Um ecossistema de negócios,</span></span>
      <span class="linha"><span data-hero-linha>eventos e experiências.</span></span>
      <span class="linha"><span class="fecho" data-hero-linha>Você no topo.</span></span>
    </h1>
    <div class="hero__acao" data-hero>
      <a class="btn btn--primario" href="#contato">Solicite orçamento</a>
    </div>
  </div>
</section>

<!-- ===================== AUTORIDADE ===================== -->
<section class="autoridade" id="autoridade" aria-label="Destaques do Bandeiras Empresarial">
  <div class="wrap autoridade__grade">
    <p class="autoridade__item">Estrutura versátil</p>
    <p class="autoridade__item"><span><span data-contar="100">100</span> mil m²</span></p>
    <p class="autoridade__item">Localização estratégica</p>
  </div>
</section>

<!-- ===================== CONCEITO 360° ===================== -->
<section class="secao escuro conceito" id="conceito-360">
  <div class="wrap cabeca-secao">
    <div class="revelar">
      <p class="eyebrow">Conceito 360°</p>
      <h2 class="titulo">Tudo o que seu evento precisa. <span class="fecho">Em um lugar que oferece muito mais.</span></h2>
    </div>
    <div class="revelar" data-atraso="1">
      <p class="texto">Um grande evento começa com o espaço certo. Mas ganha outra dimensão quando encontra novas possibilidades. No Bandeiras, diferentes ambientes permitem criar, combinar e transformar cada momento da programação — de grandes apresentações a encontros mais próximos, de ativações de marca a experiências que saem do convencional.</p>
      <p class="texto"><strong>Um só evento. Diferentes formas de surpreender, conectar e gerar negócios.</strong></p>
    </div>
  </div>
  <div class="video" id="video-conceito">
    <div class="video__moldura" data-expandir>
      <video src="https://media.dmove.com.br/clients/bandeiras/videos/bandeiras-corporativo-conceito-360.mp4" poster="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-conceito-360-capa.webp" preload="none" playsinline controls aria-label="Vídeo de apresentação do Bandeiras Empresarial"></video>
      <div class="video__capa">
        <img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-conceito-360-capa.webp" alt="Vista aérea do complexo Bandeiras Empresarial, com galpões, estacionamento e a torre vermelha da marca" loading="lazy" decoding="async">
      </div>
      <button class="video__play" type="button" aria-label="Assistir ao vídeo do Bandeiras Empresarial">
        <span class="video__icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5v19L21 12z" fill="currentColor"/></svg></span>
      </button>
    </div>
  </div>
</section>

<!-- ===================== ESPAÇOS ===================== -->
<section class="secao espacos" id="espacos">
  <div class="wrap">
    <div class="cabeca-secao cabeca-secao--centro">
      <div class="revelar">
        <p class="eyebrow">Espaços</p>
        <h2 class="titulo titulo--2linhas"><span class="titulo__linha">Grandes ideias merecem</span> <span class="fecho">um espaço à altura</span></h2>
      </div>
    </div>
    <div class="abas revelar">
      <div class="abas__lista" role="tablist" aria-label="Espaços">
        <button class="abas__aba" type="button" role="tab" id="aba-auditorio" aria-controls="auditorio" aria-selected="true" tabindex="0"><span class="abas__num">01</span><span class="abas__nome">Auditório</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-espaco-motor" aria-controls="espaco-motor" aria-selected="false" tabindex="-1"><span class="abas__num">02</span><span class="abas__nome">Espaço Motor</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-hangar" aria-controls="hangar" aria-selected="false" tabindex="-1"><span class="abas__num">03</span><span class="abas__nome">Hangar</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-espaco-arena" aria-controls="espaco-arena" aria-selected="false" tabindex="-1"><span class="abas__num">04</span><span class="abas__nome">Espaço Arena</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-pista-de-drift" aria-controls="pista-de-drift" aria-selected="false" tabindex="-1"><span class="abas__num">05</span><span class="abas__nome">Pista de Drift</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-salas-de-treinamento" aria-controls="salas-de-treinamento" aria-selected="false" tabindex="-1"><span class="abas__num">06</span><span class="abas__nome">Salas de treinamento</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-espaco-wellness" aria-controls="espaco-wellness" aria-selected="false" tabindex="-1"><span class="abas__num">07</span><span class="abas__nome">Espaço Wellness</span></button>
      </div>
      <div class="abas__painel" role="tabpanel" id="auditorio" aria-labelledby="aba-auditorio">
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Auditório"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-mesas-plateia.webp" alt="Auditório com mesas e plateia voltadas para o palco" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">01 / 07</p>
          <h3 class="abas__titulo">Auditório</h3>
          <p class="abas__texto">Capacidade para até 250 pessoas, com painel de LED 4K de 11 metros, som Yamaha, iluminação automatizada e ambiente climatizado.</p>
          <div class="abas__miniaturas" style="--colunas:3">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-mesas-plateia.webp" alt="Auditório com mesas e plateia voltadas para o palco" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-palco.webp" alt="Palco do auditório com painel de LED" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-painel-led.webp" alt="Painel de LED 4K de 11 metros do auditório" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="espaco-motor" aria-labelledby="aba-espaco-motor" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Espaço Motor"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/motor-lounge.webp" alt="Lounge do Espaço Motor" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">02 / 07</p>
          <h3 class="abas__titulo">Espaço Motor</h3>
          <p class="abas__texto">Um ambiente temático de automobilismo para encontros corporativos, networking, ativações de marca e experiências.</p>
          <div class="abas__miniaturas" style="--colunas:3">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/motor-lounge.webp" alt="Lounge do Espaço Motor" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/motor-escritorios.webp" alt="Escritórios do Espaço Motor" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-espaco-motor-1.webp" alt="Espaço Motor com carros de corrida expostos sob o pé-direito alto e paredes de tijolo" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="hangar" aria-labelledby="aba-hangar" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Hangar"><img width="1672" height="941" src="https://media.dmove.com.br/clients/bandeiras/photos/20B268B3-4E10-4F50-9CA7-A855CA0C07BE.PNG.webp" alt="Hangar do Bandeiras Empresarial preparado para evento" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">03 / 07</p>
          <h3 class="abas__titulo">Hangar</h3>
          <p class="abas__texto">Um espaço amplo e versátil para eventos corporativos, ideal para convenções, lançamentos, exposições, ativações de marca e grandes encontros empresariais.</p>
          <div class="abas__miniaturas" style="--colunas:5">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1672" height="941" src="https://media.dmove.com.br/clients/bandeiras/photos/20B268B3-4E10-4F50-9CA7-A855CA0C07BE.PNG.webp" alt="Hangar do Bandeiras Empresarial preparado para evento" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1672" height="941" src="https://media.dmove.com.br/clients/bandeiras/photos/849C70FA-D39B-451E-B8F2-E58C8BE6B9F6.PNG.webp" alt="Hangar do Bandeiras Empresarial com montagem para evento corporativo" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1672" height="941" src="https://media.dmove.com.br/clients/bandeiras/photos/EE2FC11C-7D31-4448-A09B-44C7F22439A7.PNG.webp" alt="Ambiente amplo do Hangar do Bandeiras Empresarial" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="2048" height="1536" src="https://media.dmove.com.br/clients/bandeiras/photos/IMG_5548.JPG.webp" alt="Evento realizado no Hangar do Bandeiras Empresarial" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="4"><img width="1536" height="2048" src="https://media.dmove.com.br/clients/bandeiras/photos/IMG_5577.JPG.webp" alt="Detalhe do Hangar do Bandeiras Empresarial" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="espaco-arena" aria-labelledby="aba-espaco-arena" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Espaço Arena"><img width="1024" height="632" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-espaco-arena-2.webp" alt="Espaço Arena ao entardecer, com degraus iluminados e a torre do Bandeiras ao fundo" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">04 / 07</p>
          <h3 class="abas__titulo">Espaço Arena</h3>
          <p class="abas__texto">Com planta livre e versátil, permite explorar feiras, exposições, ativações, lançamentos e confraternizações.</p>
          <div class="abas__miniaturas" style="--colunas:3">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="632" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-espaco-arena-2.webp" alt="Espaço Arena ao entardecer, com degraus iluminados e a torre do Bandeiras ao fundo" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="477" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-espaco-arena-1.webp" alt="Vista ampla do Espaço Arena ao pôr do sol" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="684" src="https://media.dmove.com.br/clients/bandeiras/photos/arena-noturna.webp" alt="Espaço Arena à noite" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="pista-de-drift" aria-labelledby="aba-pista-de-drift" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Pista de Drift"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/pista-drift-mural.webp" alt="Mural na Pista de Drift" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">05 / 07</p>
          <h3 class="abas__titulo">Pista de Drift</h3>
          <p class="abas__texto">Uma área dedicada a experiências automobilísticas, ideal para ações de marca, demonstrações e dinâmicas corporativas.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/pista-drift-mural.webp" alt="Mural na Pista de Drift" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/pista-drift-marcas.webp" alt="Marcas de pneu na Pista de Drift" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-pista-drift-3.webp" alt="Pista de Drift ao ar livre, com piso de concreto e galpões ao fundo" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-pista-drift-2.webp" alt="Vista aérea da Pista de Drift com marcas de pneu" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="salas-de-treinamento" aria-labelledby="aba-salas-de-treinamento" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Salas de treinamento"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-3.webp" alt="Sala de treinamento em formato U" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">06 / 07</p>
          <h3 class="abas__titulo">Salas de treinamento</h3>
          <p class="abas__texto">4 salas com diferentes capacidades e layouts adaptáveis, como auditório, escolar, em U ou mesa redonda, equipadas para treinamentos, workshops e encontros corporativos.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-3.webp" alt="Sala de treinamento em formato U" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-1.webp" alt="Sala de treinamento com mesas em fileiras, cadeiras laranja e TV" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-2.webp" alt="Sala de treinamento montada em formato escolar com parede de tijolo" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-4.webp" alt="Sala de treinamento em formato U vista do fundo" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="espaco-wellness" aria-labelledby="aba-espaco-wellness" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Espaço Wellness"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-galeria-wellness-2.webp" alt="Gramado à beira do rio com pergolado" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">07 / 07</p>
          <h3 class="abas__titulo">Espaço Wellness</h3>
