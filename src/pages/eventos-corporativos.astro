---
// Gerado por tools/build-page.mjs a partir do HTML do Claude Design.
import Base from '../layouts/Base.astro';
import LeadForm from '../components/form/LeadForm.astro';
import Rodape from '../components/Rodape.astro';
import { tipoEventoOptionsCorporativo } from '../scripts/form-presets';
import '../styles/bandeiras-base.css';
import '../styles/eventos-corporativos.css';
import '../styles/form.css';
---

<Base
  title="Eventos corporativos em Votorantim | Bandeiras Empresarial"
  description="Um ecossistema que conecta empresas, pessoas e experiências. Auditório, salas de treinamento, Espaço Motor, Espaço Arena e Pista de Drift em 100 mil m² em Votorantim, região de Sorocaba. Solicite orçamento."
  ogImage="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-hero-fachada.webp"
  canonical="https://eventos.bandeirasempresarial.com.br/eventos-corporativos/"
  whatsAppShowEmpresaField={true}
  whatsAppTipoOptions={tipoEventoOptionsCorporativo}
>
<Fragment slot="head">
  <link rel="preload" href="/fonts/Nexa-Heavy.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;500&family=Roboto:wght@400;500;700&display=swap" />
  <script is:inline>
    /* "js": recursos que dependem de script. "js-anim": animações de entrada, só sem pedido de movimento reduzido. */
    document.documentElement.classList.add('js');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-anim');
  </script>
</Fragment>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>


<main id="conteudo">

<!-- ===================== HERO ===================== -->
<section class="hero" id="topo">
  <div class="hero__topo">
    <div class="wrap"><a class="hero__logo" href="#topo"><img width="720" height="107" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-logo-bandeiras-branco.webp" alt="Bandeiras Empresarial"></a></div>
  </div>
  <div class="hero__midia">
    <img width="1920" height="1080" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-hero-fachada.webp" alt="Fachada do Bandeiras Empresarial ao entardecer, na Av. Ireno da Silva Venâncio, 199, em Votorantim" fetchpriority="high" decoding="async">
  </div>
  <div class="wrap hero__conteudo">
    <p class="eyebrow eyebrow--claro" data-hero>Eventos Corporativos • Votorantim</p>
    <h1 class="hero__titulo">
      <span class="linha"><span data-hero-linha>Um ecossistema que conecta</span></span>
      <span class="linha"><span class="fecho" data-hero-linha>empresas, pessoas e experiências</span></span>
    </h1>
    <div class="hero__acao" data-hero>
      <a class="btn btn--primario" href="#contato">Solicite orçamento</a>
    </div>
  </div>
</section>

<!-- ===================== AUTORIDADE ===================== -->
<section class="autoridade" id="autoridade" aria-label="Destaques do Bandeiras Empresarial">
  <div class="wrap autoridade__grade">
    <p class="autoridade__item">Estrutura versátil</p>
    <p class="autoridade__item"><span><span data-contar="100">100</span> mil m²</span></p>
    <p class="autoridade__item">Localização estratégica</p>
  </div>
</section>

<!-- ===================== CONCEITO 360° ===================== -->
<section class="secao escuro conceito" id="conceito-360">
  <div class="wrap cabeca-secao">
    <div class="revelar">
      <p class="eyebrow">Conceito 360°</p>
      <h2 class="titulo">Negócios, tecnologia e experiências <span class="fecho">em um só lugar</span></h2>
    </div>
    <div class="revelar" data-atraso="1">
      <p class="texto">No Bandeiras Empresarial, negócios, tecnologia e automobilismo se encontram em um ecossistema que amplia as possibilidades dos eventos corporativos. Com espaços que podem ser integrados em uma mesma programação e experiências da Scuderia Bandeiras, seu evento pode combinar conteúdo, networking, ativações e dinâmicas que aproximam marcas e pessoas de novas formas.</p>
    </div>
  </div>
  <div class="video" id="video-conceito">
    <div class="video__moldura" data-expandir>
      <video src="https://media.dmove.com.br/clients/bandeiras/videos/bandeiras-corporativo-conceito-360.mp4" poster="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-conceito-360-capa.webp" preload="none" playsinline controls aria-label="Vídeo de apresentação do Bandeiras Empresarial"></video>
      <div class="video__capa">
        <img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-conceito-360-capa.webp" alt="Vista aérea do complexo Bandeiras Empresarial, com galpões, estacionamento e a torre vermelha da marca" loading="lazy" decoding="async">
      </div>
      <button class="video__play" type="button" aria-label="Assistir ao vídeo do Bandeiras Empresarial">
        <span class="video__icone"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5v19L21 12z" fill="currentColor"/></svg></span>
      </button>
    </div>
  </div>
</section>

<!-- ===================== ESPAÇOS ===================== -->
<section class="secao espacos" id="espacos">
  <div class="wrap">
    <div class="cabeca-secao cabeca-secao--centro">
      <div class="revelar">
        <p class="eyebrow">Espaços</p>
        <h2 class="titulo titulo--2linhas"><span class="titulo__linha">Grandes ideias merecem</span> <span class="fecho">um espaço à altura</span></h2>
      </div>
    </div>
    <div class="abas revelar">
      <div class="abas__lista" role="tablist" aria-label="Espaços">
        <button class="abas__aba" type="button" role="tab" id="aba-escritorios-e-salas-comerciais" aria-controls="escritorios-e-salas-comerciais" aria-selected="true" tabindex="0"><span class="abas__num">01</span><span class="abas__nome">Escritórios e salas comerciais</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-salas-de-reuniao" aria-controls="salas-de-reuniao" aria-selected="false" tabindex="-1"><span class="abas__num">02</span><span class="abas__nome">Salas de reunião</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-salas-de-treinamento" aria-controls="salas-de-treinamento" aria-selected="false" tabindex="-1"><span class="abas__num">03</span><span class="abas__nome">Salas de treinamento</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-salas-privativas" aria-controls="salas-privativas" aria-selected="false" tabindex="-1"><span class="abas__num">04</span><span class="abas__nome">Salas privativas</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-auditorio" aria-controls="auditorio" aria-selected="false" tabindex="-1"><span class="abas__num">05</span><span class="abas__nome">Auditório</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-coworking" aria-controls="coworking" aria-selected="false" tabindex="-1"><span class="abas__num">06</span><span class="abas__nome">Coworking</span></button>
        <button class="abas__aba" type="button" role="tab" id="aba-estudio-de-podcast" aria-controls="estudio-de-podcast" aria-selected="false" tabindex="-1"><span class="abas__num">07</span><span class="abas__nome">Estúdio de podcast</span></button>
      </div>
      <div class="abas__painel" role="tabpanel" id="escritorios-e-salas-comerciais" aria-labelledby="aba-escritorios-e-salas-comerciais">
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Escritórios e salas comerciais"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-escritorios-1.webp" alt="Corredor de escritórios com salas de vidro" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">01 / 07</p>
          <h3 class="abas__titulo">Escritórios e salas comerciais</h3>
          <p class="abas__texto">Ambientes a partir de 40 m², com flexibilidade para diferentes necessidades profissionais.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-escritorios-1.webp" alt="Corredor de escritórios com salas de vidro" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-escritorios-2.webp" alt="Corredor central entre salas comerciais" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-escritorios-3.webp" alt="Salas comerciais com divisórias de vidro jateado" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1600" height="900" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-escritorios-4.webp" alt="Escritório com parede de tijolo e mesas de trabalho" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="salas-de-reuniao" aria-labelledby="aba-salas-de-reuniao" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Salas de reunião"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-reuniao-1.webp" alt="Sala de reunião com mesa central e parede de vidro" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">02 / 07</p>
          <h3 class="abas__titulo">Salas de reunião</h3>
          <p class="abas__texto">Salas modernas e equipadas com TVs, privacidade e conforto para reuniões de até 10 pessoas.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-reuniao-1.webp" alt="Sala de reunião com mesa central e parede de vidro" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="471" height="276" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-reuniao-2.webp" alt="Sala de reunião com parede de tijolo, mesa e cadeiras verdes" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="salas-de-treinamento" aria-labelledby="aba-salas-de-treinamento" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Salas de treinamento"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-1.webp" alt="Sala de treinamento com mesas em fileiras, cadeiras laranja e TV" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">03 / 07</p>
          <h3 class="abas__titulo">Salas de treinamento</h3>
          <p class="abas__texto">4 salas com diferentes capacidades e layouts adaptáveis, como auditório, escolar, em U ou mesa redonda, equipadas para treinamentos, workshops e encontros corporativos.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-1.webp" alt="Sala de treinamento com mesas em fileiras, cadeiras laranja e TV" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-2.webp" alt="Sala de treinamento montada em formato escolar com parede de tijolo" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-3.webp" alt="Sala de treinamento em formato U" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-treinamento-4.webp" alt="Sala de treinamento em formato U vista do fundo" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="salas-privativas" aria-labelledby="aba-salas-privativas" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Salas privativas"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-privativa-1.webp" alt="Sala privativa com estações de trabalho" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">04 / 07</p>
          <h3 class="abas__titulo">Salas privativas</h3>
          <p class="abas__texto">Salas mobiliadas para até 4 pessoas, ideais para trabalhar com conforto, privacidade e praticidade.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-privativa-1.webp" alt="Sala privativa com estações de trabalho" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-privativa-2.webp" alt="Sala privativa com mesa dupla e cadeiras ergonômicas" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-privativa-3.webp" alt="Sala privativa com mesa e armário" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-sala-privativa-4.webp" alt="Sala privativa com mesa, monitor e banco" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="auditorio" aria-labelledby="aba-auditorio" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Auditório"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-painel-led.webp" alt="Auditório com painel de LED aceso e cadeiras em formato plateia" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">05 / 07</p>
          <h3 class="abas__titulo">Auditório</h3>
          <p class="abas__texto">Capacidade para até 250 pessoas, com painel de LED 4K de 11 metros, som Yamaha, iluminação automatizada e ambiente climatizado.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-painel-led.webp" alt="Auditório com painel de LED aceso e cadeiras em formato plateia" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-palco.webp" alt="Palco do auditório visto do fundo da sala" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-mesas-plateia.webp" alt="Auditório montado com mesas e cadeiras laranja" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="3"><img width="1024" height="576" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-auditorio-infraestrutura.webp" alt="Auditório com paredes de tijolo aparente e iluminação cênica" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="coworking" aria-labelledby="aba-coworking" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Coworking"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-coworking-1.webp" alt="Coworking com mesas compartilhadas e estantes de troféus" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">06 / 07</p>
          <h3 class="abas__titulo">Coworking</h3>
          <p class="abas__texto">Um espaço compartilhado para trabalhar, conectar-se a outros profissionais e ter mais flexibilidade na rotina.</p>
          <div class="abas__miniaturas" style="--colunas:4">
          <button class="abas__mini is-ativa" type="button" data-i="0"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-coworking-1.webp" alt="Coworking com mesas compartilhadas e estantes de troféus" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="1"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-coworking-2.webp" alt="Duas pessoas trabalhando em mesa do coworking" loading="lazy" decoding="async"></button>
          <button class="abas__mini" type="button" data-i="2"><img width="1000" height="667" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-coworking-3.webp" alt="Cabine estofada do coworking com notebook" loading="lazy" decoding="async"></button>
          </div>
          <div class="abas__acao"><a class="btn btn--primario" href="#contato">Agende sua visita</a></div>
        </div>
      </div>
      <div class="abas__painel" role="tabpanel" id="estudio-de-podcast" aria-labelledby="aba-estudio-de-podcast" hidden>
        <button class="abas__foto" type="button" aria-label="Ampliar foto: Estúdio de podcast"><img width="800" height="500" src="https://media.dmove.com.br/clients/bandeiras/photos/bandeiras-corporativo-estudio-podcast-1.webp" alt="Bancada do estúdio de podcast com microfones e telão" loading="lazy" decoding="async"><span class="abas__lupa" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6"/></svg></span></button>
        <div class="abas__info">
          <p class="abas__contagem">07 / 07</p>
          <h3 class="abas__titulo">Estúdio de podcast</h3>
          <p class="abas__texto">Estúdio profissional com equipamentos completos, acústica planejada e suporte técnico especializado.</p>
